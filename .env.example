# SafetyScale — produção com Compose
# Copiar para `.env` na mesma pasta e definir valores reais antes de subir.

# SQL Server — senha do `sa`, atenda à política de complexidade Microsoft
MSSQL_SA_PASSWORD=changeme_UseStrongPw1!

# Base de dados lógica (criada/atualizada via migrations EF na primeira subida da API)
SAFETYSCALE_DB_NAME=SafetyScale

# JWT — use segredo forte (ex.: ≥ 32 caracteres aleatórios)
JWT_ISSUER=SafetyScale
JWT_AUDIENCE=SafetyScale.Api
JWT_KEY=changeme_UseLongRandomKey_AtLeast32chars
JWT_EXPIRY_MINUTES=120

# Porta onde o navegador acessará a SPA (+ proxy /api para a API interna)
WEB_PORT=80

# SKU SQL Server dentro do Linux container (opcional)
# MSSQL_PID=Developer
