# SafetyScale — produção com Compose
# Copiar para `.env` na mesma pasta e definir valores reais antes de subir.

# SQL Server — senha do `sa`, atenda à política de complexidade Microsoft
MSSQL_SA_PASSWORD=changeme_UseStrongPw1!

# Porta TCP do SQL Server exposta no host (a API continua usando sqlserver:1433 na rede interna)
SQLSERVER_PORT=1433

# Base de dados lógica (criada/atualizada via migrations EF na primeira subida da API)
SAFETYSCALE_DB_NAME=SafetyScale

# JWT — use segredo forte (ex.: ≥ 32 caracteres aleatórios)
JWT_ISSUER=SafetyScale
JWT_AUDIENCE=SafetyScale.Api
JWT_KEY=changeme_UseLongRandomKey_AtLeast32chars
JWT_EXPIRY_MINUTES=120

# Porta onde o navegador acessará a SPA (+ proxy /api para a API interna)
WEB_PORT=80

# Porta host da API (acesso direto HTTP na API; dentro da rede Compose o Nginx usa api:8080)
API_PORT=8081

# Origens do browser autorizadas no CORS da API (Cors__OriginsCsv). Separadas por vírgula sem espaços extras —
# exemplo: https://app.exemplo.com,http://localhost:5173
# Deixe vazio se só acessar a SPA pelo mesmo host/origem onde o /api faz proxy (Nginx neste compose) — não há chamada cross-origin.
CORS_ORIGINS=

# URL base absoluta da API no front (injeta na build da SPA). Deixe vazio para usar caminhos relativos /api
# (combina com o proxy Nginx do compose). Use https://api.exemplo.com só se o SPA chamar um host/porta diferentes.
VITE_API_BASE_URL=

# SKU SQL Server dentro do Linux container (opcional)
# MSSQL_PID=Developer
