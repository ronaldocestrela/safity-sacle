# SafetyScale — produção com Compose
# Copiar para `.env` na mesma pasta e definir valores reais antes de subir.

# SQL Server — senha do `sa`, atenda à política de complexidade Microsoft
MSSQL_SA_PASSWORD=changeme_UseStrongPw1!

# Porta TCP do SQL Server exposta no host (a API continua usando sqlserver:1433 na rede interna)
SQLSERVER_PORT=1433

# Base de dados lógica (criada/atualizada via migrations EF na primeira subida da API)
SAFETYSCALE_DB_NAME=SafetyScale

# JWT — use segredo forte (ex.: ≥ 32 caracteres aleatórios)
JWT_ISSUER=SafetyScale
JWT_AUDIENCE=SafetyScale.Api
JWT_KEY=changeme_UseLongRandomKey_AtLeast32chars
JWT_EXPIRY_MINUTES=120

# Porta onde o navegador acessará o frontend Blazor (+ proxy /api para a API interna)
WEB_PORT=80

# Porta host da API (acesso direto HTTP na API; dentro da rede Compose o Nginx usa api:8080)
API_PORT=8081

# Origens do browser autorizadas no CORS da API (Cors__OriginsCsv). Separadas por vírgula sem espaços extras —
# exemplo: https://app.exemplo.com,http://localhost:4864
# Deixe vazio se só acessar o front pelo mesmo host/origem onde o /api faz proxy (Nginx neste compose).
CORS_ORIGINS=

# URL base absoluta da API no build do Blazor WASM (build-arg API_BASE_URL).
# Vazio = caminhos relativos /api (same-origin via Nginx). Preencha só em split-origin (+ CORS_ORIGINS).
API_BASE_URL=

# SKU SQL Server dentro do Linux container (opcional)
# MSSQL_PID=Developer

# URL pública do frontend Blazor (links de confirmação de e-mail)
PUBLIC_WEB_BASE_URL=http://localhost

# SMTP — envio de e-mails (ex.: Gmail: smtp.gmail.com:587 + senha de app)
# Deixe SMTP_HOST vazio para desabilitar envio real (a fila continua persistindo mensagens).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_DISPLAY_NAME=SafetyScale
SMTP_ENABLE_SSL=true

# Fila de e-mails assíncrona (worker embutido na API)
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_POLL_INTERVAL_SECONDS=5
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_MAX_ATTEMPTS=5
EMAIL_QUEUE_INITIAL_RETRY_DELAY_SECONDS=30
EMAIL_QUEUE_MAX_RETRY_DELAY_SECONDS=3600
EMAIL_QUEUE_STALE_PROCESSING_MINUTES=10
