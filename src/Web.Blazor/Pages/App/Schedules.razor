@page "/app/schedules"
@layout AppLayout
@attribute [Authorize]
@inject AuthSessionService AuthService

<PageTitle>SafetyScale — Escalas</PageTitle>

<RoleAuthorizeView AllowedRoles="ModuleRoles">
    <div class="page">
        <AppHeader Title="SentryOps Management"
                   Subtitle="Regras de agendamento e distribuição de pessoal."
                   Email="@_session?.Email"
                   AvatarSrc="@StitchSupervisorAvatar"
                   ShowNotifications="true"
                   ShowLogout="true"
                   OnLogout="HandleLogoutAsync" />

        <main class="main">
            <section class="placeholder-panel">
                <p class="placeholder-lead">Placeholder B3.1 — implementação na fase B9.</p>
            </section>
        </main>
    </div>
</RoleAuthorizeView>

@code {
    private const string StitchSupervisorAvatar =
        "https://lh3.googleusercontent.com/aida-public/AB6AXuB3nCVQo7BaVjs8Plm0dqDT-E72JA3LPXwRXpOy29LCTHdvE1U5-EfUrZ-8tZimS_qhsHFF3tbZ6vUGALNuRIHq8a5kzFrh0VuT0tqtWlBDhJf5B5Sz-BuS67N70iHrMJCJ41gO9PFGy0Ga9TSdJapjQQgFQDMHxQkrg7PRBL7RegsZqWDyLHaWh-oG6vUTddUnGkCKhX-8Evg0_qkcqk07E1eOADjs_HqJVISLP6Auwqyg11YgZnaa2ozlYUht-0ThG-nIE8lY9UU";

    private static readonly UserRole[] ModuleRoles = [UserRole.Admin, UserRole.Supervisor];

    private AuthSession? _session;

    protected override async Task OnInitializedAsync() =>
        _session = await AuthService.GetSessionAsync();

    private Task HandleLogoutAsync() =>
        AuthService.LogoutAsync(navigateToLogin: true);
}
