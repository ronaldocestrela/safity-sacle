@page "/set-password"
@inject NavigationManager Navigation
@inject AuthSessionService AuthService

<PageTitle>SafetyScale — Definir senha</PageTitle>

<div class="page">
    <div class="card">
        <div class="card-header">
            <span class="logo">SafetyScale</span>
            <h1 class="title">Definir senha</h1>
            <p class="lead">Crie sua senha para acessar a plataforma.</p>
        </div>

        <div class="form">
            @if (_status == SetPasswordOutcomeStatus.Success)
            {
                <p class="banner">@_message</p>
                <a class="submit link-button" href="/login">Ir para login</a>
            }
            else if (_showForm)
            {
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <p class="error" role="alert">@_formError</p>
                }

                <form @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault="true">
                    <label class="label" for="password-input">
                        Nova senha
                        <input id="password-input"
                               class="input"
                               type="password"
                               autocomplete="new-password"
                               @bind="_password"
                               disabled="@_submitting" />
                    </label>

                    <label class="label" for="confirm-password-input">
                        Confirmar senha
                        <input id="confirm-password-input"
                               class="input"
                               type="password"
                               autocomplete="new-password"
                               @bind="_confirmPassword"
                               disabled="@_submitting" />
                    </label>

                    <button type="submit" class="submit" disabled="@_submitting">
                        @(_submitting ? "Salvando…" : "Definir senha")
                    </button>
                </form>
            }
            else if (_status == SetPasswordOutcomeStatus.InvalidToken)
            {
                <p class="error" role="alert">@_message</p>
                <a class="link" href="/login">Voltar ao login</a>
            }
            else if (_status == SetPasswordOutcomeStatus.UserNotFound)
            {
                <p class="error" role="alert">@_message</p>
                <a class="link" href="/login">Voltar ao login</a>
            }
            else
            {
                <p class="error" role="alert">@_message</p>
                <a class="link" href="/login">Voltar ao login</a>
            }
        </div>
    </div>
</div>

@code {
    private bool _submitting;
    private bool _showForm;
    private SetPasswordOutcomeStatus? _status;
    private string? _message;
    private string? _formError;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        _showForm = !string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Token);
        if (!_showForm)
        {
            _status = SetPasswordOutcomeStatus.InvalidToken;
            _message = "Link inválido ou expirado.";
        }
    }

    private async Task HandleSubmitAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_password))
        {
            _formError = "Informe a nova senha.";
            return;
        }

        if (!string.Equals(_password, _confirmPassword, StringComparison.Ordinal))
        {
            _formError = "A senha e a confirmação não conferem.";
            return;
        }

        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            _formError = "Link inválido ou expirado.";
            return;
        }

        _submitting = true;
        var result = await AuthService.SetPasswordAsync(UserId, Token, _password);
        _status = result.Status;
        _message = result.Message ?? ResolveDefaultMessage(result.Status);
        _showForm = false;
        _submitting = false;
    }

    private static string ResolveDefaultMessage(SetPasswordOutcomeStatus status) =>
        status switch
        {
            SetPasswordOutcomeStatus.Success => "Senha definida com sucesso. Você já pode entrar.",
            SetPasswordOutcomeStatus.InvalidPassword => "Senha inválida. Use ao menos 8 caracteres, com maiúscula, minúscula, número e caractere especial.",
            SetPasswordOutcomeStatus.InvalidToken => "Link inválido ou expirado.",
            SetPasswordOutcomeStatus.UserNotFound => "Usuário não encontrado.",
            SetPasswordOutcomeStatus.Network => "Não foi possível conectar à API. Tente novamente.",
            _ => "Não foi possível definir a senha.",
        };
}
