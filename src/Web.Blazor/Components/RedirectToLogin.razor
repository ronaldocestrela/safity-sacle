@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnPath = BuildReturnPath();
        var isPlatformRoute = returnPath?.StartsWith("/platform", StringComparison.OrdinalIgnoreCase) == true;

        if (returnPath is null)
        {
            Navigation.NavigateTo(isPlatformRoute ? "/platform/login" : "/login", replace: true);
            return;
        }

        var encoded = Uri.EscapeDataString(returnPath);
        Navigation.NavigateTo(
            isPlatformRoute ? $"/platform/login?returnUrl={encoded}" : $"/login?returnUrl={encoded}",
            replace: true);
    }

    private string? BuildReturnPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(relative))
        {
            return null;
        }

        var path = relative.StartsWith('/') ? relative : $"/{relative}";
        var queryIndex = path.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex >= 0)
        {
            path = path[..queryIndex];
        }

        if (path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("/platform/login", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return path;
    }
}
