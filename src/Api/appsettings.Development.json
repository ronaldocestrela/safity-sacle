{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=safetyscale.dev.db"
  },
  "Jwt": {
    "Issuer": "SafetyScale",
    "Audience": "SafetyScale.Api",
    "Key": "THIS_IS_A_DEVELOPMENT_KEY_CHANGE_IN_PRODUCTION_123456",
    "ExpiryMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "Origins": [ "http://localhost:4863" ]
  }
}
